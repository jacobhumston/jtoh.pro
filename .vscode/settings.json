    "files.exclude": {
        "**/.git": false,
        "**/.svn": false,
        "**/.hg": false,
        "**/.DS_Store": false,
        "**/Thumbs.db": false
    },
    "hide-files.files": ["cache", "db", "logs", "node_modules", "temp", "src/web/app/blog"],
    "bun.runtime": "/node_modules/.bin/bun",

    // If support for Bun should be added to the default "JavaScript Debug Terminal".
    "bun.debugTerminal.enabled": true,

    // If the debugger should stop on the first line of the program.
    "bun.debugTerminal.stopOnEntry": false,

    // Glob pattern to find test files. Defaults to the value shown below.
    "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts}",

    // TypeScript configuration for different runtime environments
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.suggest.autoImports": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.preferences.includeCompletionsForModuleExports": true
}
