{
    "trailingComma": "none",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "useTabs": false,
    "endOfLine": "auto",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<THIRD_PARTY_MODULES>",
        "",
        "^(node:|bun:|bun)",
        "<BUILTIN_MODULES>",
        "",
        "^@(server|client|shared|discord|schemas)/",
        "",
        "^[./]"
    ]
}
